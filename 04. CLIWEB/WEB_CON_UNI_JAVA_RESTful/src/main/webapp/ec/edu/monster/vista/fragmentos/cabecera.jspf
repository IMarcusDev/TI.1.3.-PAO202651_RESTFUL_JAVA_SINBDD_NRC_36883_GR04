<%-- Shared header. The including page declares the "c" taglib and may set
     "seccion" (menu, conversion, catalogo) to show the navigation.
     The server status is refreshed every few seconds by js/estado.js. --%>
<header class="cabecera">
    <span class="cabecera-titulo">Conversión de Unidades Monster</span>
    <c:if test="${not empty seccion}">
        <nav class="cabecera-menu">
            <a href="${pageContext.request.contextPath}/conversion"
               class="${seccion == 'conversion' ? 'activo' : ''}">Convertir</a>
            <a href="${pageContext.request.contextPath}/catalogo"
               class="${seccion == 'catalogo' ? 'activo' : ''}">Catálogo</a>
            <form method="post" action="${pageContext.request.contextPath}/logout" class="cabecera-salir">
                <button type="submit">Cerrar sesión</button>
            </form>
        </nav>
    </c:if>
    <%-- Pages that did not check the server yet (servicioDisponible unset) start as available;
         the script corrects it on load. --%>
    <c:set var="inicialDisponible" value="${empty servicioDisponible or servicioDisponible}"/>
    <span class="estado" id="estado-servicio" data-url="${pageContext.request.contextPath}/estado"><span
            class="estado-punto${inicialDisponible ? '' : ' inactivo'}"></span><c:if test="${not empty seccion}">Sesión activa · </c:if><span
            class="estado-texto">${inicialDisponible ? 'Servicio disponible' : 'Servicio no disponible'}</span></span>
</header>
<script src="${pageContext.request.contextPath}/js/estado.js" defer></script>
