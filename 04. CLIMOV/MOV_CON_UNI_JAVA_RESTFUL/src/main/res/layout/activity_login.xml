<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_app"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/barraSuperior"
        style="@style/BarraSuperior"
        app:title="@string/app_titulo" />

    <ScrollView
        android:id="@+id/contenido"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp">

            <com.google.android.material.card.MaterialCardView
                style="@style/Tarjeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="28dp"
                    android:paddingTop="32dp"
                    android:paddingEnd="28dp"
                    android:paddingBottom="32dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="28dp"
                        android:accessibilityHeading="true"
                        android:text="@string/login_titulo"
                        android:textColor="@color/monster_primary"
                        android:textSize="32sp" />

                    <TextView
                        style="@style/CampoEtiqueta"
                        android:labelFor="@id/txtUsuario"
                        android:text="@string/login_usuario" />

                    <EditText
                        android:id="@+id/txtUsuario"
                        style="@style/CampoTexto"
                        android:layout_marginBottom="20dp"
                        android:autofillHints="username"
                        android:imeOptions="actionNext"
                        android:inputType="text|textNoSuggestions" />

                    <TextView
                        style="@style/CampoEtiqueta"
                        android:labelFor="@id/txtClave"
                        android:text="@string/login_clave" />

                    <EditText
                        android:id="@+id/txtClave"
                        style="@style/CampoTexto"
                        android:autofillHints="password"
                        android:imeOptions="actionGo"
                        android:inputType="textPassword" />

                    <TextView
                        android:id="@+id/lblError"
                        style="@style/TextoError"
                        android:layout_marginTop="12dp"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnIngresar"
                        style="@style/BotonPrimario"
                        android:layout_marginTop="28dp"
                        android:text="@string/login_ingresar" />

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/prgCargando"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="16dp"
                        android:indeterminate="true"
                        android:visibility="gone"
                        app:indicatorColor="@color/monster_primary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </FrameLayout>
    </ScrollView>
</LinearLayout>
