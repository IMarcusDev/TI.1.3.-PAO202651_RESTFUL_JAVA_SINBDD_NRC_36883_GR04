<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Tema.Conversor" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/monster_primary</item>
        <item name="colorOnPrimary">@color/blanco</item>
        <item name="colorPrimaryContainer">@color/monster_primary</item>
        <item name="colorOnPrimaryContainer">@color/blanco</item>
        <item name="colorSecondary">@color/monster_primary</item>
        <item name="colorSurface">@color/blanco</item>
        <item name="colorOnSurface">@color/texto_oscuro</item>
        <item name="colorSurfaceContainer">@color/blanco</item>
        <item name="colorSurfaceContainerLow">@color/blanco</item>
        <item name="colorSurfaceContainerHigh">@color/blanco</item>
        <item name="colorError">@color/texto_error</item>
        <item name="android:colorBackground">@color/fondo_app</item>
        <item name="android:windowBackground">@color/fondo_app</item>
        <item name="android:textColorPrimary">@color/texto_oscuro</item>
        <item name="android:textColorHint">@color/borde_campo</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/blanco</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="materialAlertDialogTheme">@style/Tema.Conversor.Dialogo</item>
        <item name="bottomSheetDialogTheme">@style/Tema.Conversor.HojaInferior</item>
    </style>

    <style name="Tema.Conversor.Dialogo" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">@color/monster_primary</item>
        <item name="colorSurfaceContainerHigh">@color/blanco</item>
    </style>

    <style name="Tema.Conversor.HojaInferior" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/HojaInferior</item>
        <item name="android:backgroundDimAmount">0.45</item>
    </style>

    <style name="HojaInferior" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@color/blanco</item>
        <item name="shapeAppearanceOverlay">@style/FormaHojaInferior</item>
    </style>

    <style name="FormaHojaInferior" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerSizeTopRight">24dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>
</resources>
